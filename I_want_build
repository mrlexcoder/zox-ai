pythonimport requests, pyautogui, subprocess, json

def ask_llm(prompt):
    r = requests.post("http://localhost:11434/api/generate", json={
        "model": "llama3.1:8b-instruct-q4_K_M",
        "prompt": prompt,
        "stream": False
    })
    return json.loads(r.json()["response"])  # returns action JSON

def execute(action):
    if action["intent"] == "open_app":
        subprocess.Popen(action["app"])
    elif action["intent"] == "type_text":
        pyautogui.typewrite(action["text"], interval=0.05)  # human-like
    elif action["intent"] == "create_file":
        open(action["path"], "w").write(action["content"])
    # ...more handlers

while True:
    user_input = input("You: ")
    plan = ask_llm(user_input)
    execute(plan)

